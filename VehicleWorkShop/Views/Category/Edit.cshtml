@using VehicleWorkShop.ViewModels
@model CategoryVM

<form asp-action="Edit" enctype="multipart/form-data" method="post" onsubmit="return ValidateForm()">
    <div class="card shadow-lg rounded-4 border-0 animate__animated animate__fadeIn">
     
        <div class="card-header bg-gradient-primary text-white py-3">
            <h4 class="mb-0 text-center">
                <i class="bi bi-card-list me-2"></i>Update Category Information
            </h4>
        </div>

       
        <div class="card-body px-4 py-4">
            <input asp-for="CategoryId" type="hidden" />

            <div class="row justify-content-center">
                <div class="col-md-8">

                    
                    <div class="form-floating mb-4">
                        <input asp-for="Name" class="form-control" id="CategoryName" placeholder="Category Name" />
                        <label for="CategoryName">
                            <i class="bi bi-tags-fill me-2 text-primary"></i>Category Name
                        </label>
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <select asp-for="IsActive" class="form-select" id="IsActive">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                        <label for="IsActive">
                            <i class="bi bi-check2-circle me-2 text-primary"></i>Is Active
                        </label>
                        <span asp-validation-for="IsActive" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>
        </div>

     
        <div class="card-footer bg-light py-3">
            <div class="row">
                <div class="col-md-6 mb-2 mb-md-0">
                    <button type="submit" class="btn btn-success w-100 rounded-pill">
                        <i class="bi bi-save2-fill me-1"></i> Update
                    </button>
                </div>
                <div class="col-md-6">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill">
                        <i class="bi bi-arrow-left-circle me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #4b6cb7 0%, #182848 100%);
    }

    .form-control:focus, .form-select:focus {
        border-color: #4b6cb7;
        box-shadow: 0 0 0 0.25rem rgba(75, 108, 183, 0.25);
    }

    .form-floating > label {
        padding-left: 2.5rem;
    }

    .form-floating i {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
    }
</style>
