@model VehicleWorkShop.ViewModels.PurchaseInvoice
@{
    if (ViewData["From"]?.ToString() == "pdf")
    {
        Layout = null;
    }
    ViewData["Title"] = "Purchase Invoice";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            font-size: 14px;
            margin: 0;
            padding: 0;
            background: #fff;
        }

        .invoice-container {
            width: 100%;
            max-width: 900px;
            margin: 20px auto;
        }

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

            .invoice-table td, .invoice-table th {
                padding: 8px;
                border: 1px solid #ddd;
            }

        .no-border {
            border: none !important;
        }

        .title {
            font-size: 24px;
            font-weight: bold;
            color: #0d6efd;
        }

        .text-end {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .grand-total {
            background-color: #e2f0d9;
            font-weight: bold;
        }

        .signature-box {
            width: 50%;
            padding-top: 40px;
            text-align: center;
            font-style: italic;
        }

        .signature-line {
            border-top: 1px solid #000;
            margin-top: 30px;
            padding-top: 5px;
        }

        .no-print {
            margin-top: 30px;
            text-align: center;
        }

        @@media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>

    <div class="invoice-container">
        <table class="invoice-table">
      
            <tr>
                <td colspan="4" class="no-border">
                    <span class="title">Vehicle Workshop</span><br />
                    123, Main Road, Dhaka<br />
                    Email: info@vehicleworkshop.com<br />
                    Phone: +880-1762843633
                </td>
                <td colspan="3" class="no-border text-end">
                    <span class="title">Purchase Invoice</span><br />
                    Invoice ID: #@Model.InvoiceId<br />
                    Date: @Model.PurchaseDate.ToString("dd MMM yyyy")
                </td>
            </tr>

       
            <tr>
                <td colspan="7"><strong>Supplier Information:</strong></td>
            </tr>
            <tr>
                <td colspan="7">
                    <strong>@Model.SupplierName</strong><br />
                    Manager: @Model.ManagerName<br />
                    Mobile: @Model.Mobile<br />
                    Address: @Model.Address
                </td>
            </tr>

            <tr>
                <th>SL</th>
                <th>Product</th>
                <th>Model</th>
                <th>Qty</th>
                <th>Price</th>
                <th>VAT (%)</th>
                <th>Sub Total</th>
            </tr>

       
            @foreach (var item in Model.Details)
            {
                <tr>
                    <td class="text-center">@item.PurchaseDetailId</td>
                    <td>@item.ProductName</td>
                    <td>@item.ModelName</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-end">@item.Price.ToString("0.00")</td>
                    <td class="text-end">@item.Vat.ToString("0.00")</td>
                    <td class="text-end">@item.SubTotal.ToString("0.00")</td>
                </tr>
            }

     
            <tr class="grand-total">
                <td colspan="6" class="text-end">Grand Total</td>
                <td class="text-end">@Model.GrandTotal.ToString("0.00")</td>
            </tr>
        </table>

    
        <table class="invoice-table">
            <tr>
                <td class="signature-box">
                    <div class="signature-line">Authorized Signature</div>
                </td>
                <td class="signature-box">
                    <div class="signature-line">Supplier Signature</div>
                </td>
            </tr>
        </table>


        @if (ViewData["From"]?.ToString() != "pdf")
        {
            <div class="no-print">
                <button onclick="window.print()" style="padding: 8px 20px; background: #343a40; color: white; border: none; border-radius: 4px;">
                    🖨️ Print Invoice
                </button>
                <a asp-action="DownloadInvoice" asp-route-id="@Model.InvoiceId"
                   style="padding: 8px 20px; background: #0d6efd; color: white; text-decoration: none; border-radius: 4px; margin-left: 10px;">
                    ⬇️ Download PDF
                </a>
            </div>
        }

    </div>

</body>
</html>
