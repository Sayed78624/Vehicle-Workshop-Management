@model IEnumerable<VehicleWorkShop.ViewModels.StoreVM>



    <div class="row align-items-center mb-4 p-3 rounded bg-light shadow-sm">
        <div class="col-lg-4 col-md-12 mb-2 mb-lg-0">
            <h4 class="mb-0 text-success fw-bold">
                <i class="bi bi-tags-fill me-3"></i> Store List
            </h4>
        </div>
        <div class="col-lg-5 col-md-8">
            <form method="get" role="search" class="d-flex">
                <input type="text" name="searchTerm" class="form-control me-2 shadow-sm"
                       placeholder="Search by Name" value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-outline-success shadow-sm">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
        <div class="col-lg-3 col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary shadow-sm w-100">
                <i class="bi bi-person-plus-fill me-1"></i> New Store
            </a>
        </div>
    </div>

    <table class="table table-hover table-bordered table-striped mt-0">
        <thead class="table-success">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().StoreId)</th>
                <th>@Html.DisplayNameFor(model => model.First().Name)</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.StoreId</td>
                    <td>@item.Name</td>

                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.StoreId" class="btn btn-sm btn-warning me-1" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.StoreId" class="btn btn-sm btn-info me-1" title="Details">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.StoreId" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure to delete?');">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>


    @* Pagination  *@
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage - 1 })" tabindex="-1">Previous</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = i })">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage + 1 })">Next</a>
            </li>
        </ul>
    </nav>

</div>
