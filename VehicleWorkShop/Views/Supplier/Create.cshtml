@model VehicleWorkShop.ViewModels.SupplierVM

@{
    ViewData["Title"] = "Create Supplier";
}

<div class="container mt-0">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-9">
            <div class="card shadow-lg border-0 rounded-4">
            
                <div class="card-header bg-gradient-primary text-white py-3 rounded-top-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">
                            <i class="fas fa-truck-loading me-2"></i> Add New Supplier
                        </h3>
                        <a asp-action="Index" class="btn btn-sm btn-light rounded-pill">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>

             
                <div class="card-body p-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                        <div class="row g-5">
                         
                            <div class="col-md-6">
                                <label asp-for="SupplierName" class="form-label fw-semibold">
                                    Supplier Name
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white">
                                        <i class="fas fa-building"></i>
                                    </span>
                                    <input asp-for="SupplierName" class="form-control" placeholder="Enter supplier name" />
                                </div>
                                <span asp-validation-for="SupplierName" class="text-danger small"></span>
                            </div>

                          
                            <div class="col-md-6">
                                <label asp-for="Mobile" class="form-label fw-semibold">
                                    Mobile Number
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white">
                                        <i class="fas fa-mobile-alt"></i>
                                    </span>
                                    <input asp-for="Mobile" class="form-control" placeholder="Enter mobile number" />
                                </div>
                                <span asp-validation-for="Mobile" class="text-danger small"></span>
                            </div>

                          
                            <div class="col-md-6">
                                <label asp-for="Address" class="form-label fw-semibold">
                                    Address
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white">
                                        <i class="fas fa-map-marker-alt"></i>
                                    </span>
                                    <input asp-for="Address" class="form-control" placeholder="Enter address" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                           
                            <div class="col-md-6">
                                <label asp-for="Manager" class="form-label fw-semibold">
                                    Contact Person
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white">
                                        <i class="fas fa-user-tie"></i>
                                    </span>
                                    <input asp-for="Manager" class="form-control" placeholder="Enter contact person" />
                                </div>
                                <span asp-validation-for="Manager" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-5 pt-4 border-top">
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fs-5">
                                <i class="fas fa-save me-2"></i> Save Supplier
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light py-3 small text-muted text-center rounded-bottom-4">
                    <i class="fas fa-info-circle me-1 text-primary"></i> All fields are required unless marked optional.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #2b5876 0%, #4e4376 100%);
    }

    .card {
        border-radius: 0.75rem;
    }

    .btn {
        font-weight: 600;
    }
</style>

