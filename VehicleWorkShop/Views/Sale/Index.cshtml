@model IEnumerable<VehicleWorkShop.ViewModels.SaleVM>

<div class="container mt-0">

    <div class="container-fluid mt-1">

        <div class="card shadow-sm border-0">
            <style>
                .h-equal {
                    height: 38px;
                }
            </style>

            <div class="card-header" style="background-color: #e9f5ff;">

                <div class="row align-items-center g-2">


                    <div class="col-md">
                        <h5 class="mb-0 text-info">
                            <i class="fas fa-table me-2"></i> All Sales Record
                        </h5>
                    </div>

                    <div class="col-md-5">
                        <form method="get" asp-action="Index" class="input-group">
                            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                                   class="form-control form-control-sm h-equal" placeholder="Search..." />
                            <button type="submit" class="btn btn-outline-success btn-sm h-equal">
                                <i class="fas fa-search me-1"></i> Filter
                            </button>
                        </form>
                    </div>

                    <div class="col-md-auto text-end">
                        <a asp-action="Create" class="btn btn-success btn-sm h-equal d-inline-flex align-items-center">
                            <i class="fas fa-plus me-1"></i> Add Sale
                        </a>
                    </div>
                </div>
            </div>


            <div class="card-body p-0">
                <table class="table table-bordered table-hover align-middle mb-0 text-center">
                    <thead class="table-light text-uppercase small">
                        <tr>
                            <th>Sale SL</th>
                            <th>Customer Name</th>
                            <th>Description</th>
                            <th>Grand Total</th>
                            <th>Status</th>
                            <th>Action</th>
                            <th>Approval</th>
                            <th>Invoice</th>
                            <th>Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-muted fst-italic">No sales found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.SaleId</td>
                                    <td class="text-start ps-3">@item.CustomerName</td>
                                    <td class="text-start ps-3">@item.Description</td>
                                    <td class="text-start">@item.GrandTotal</td>
                                    <td>
                                        @if (item.IsApprove)
                                        {
                                            <span class="badge bg-success"> Already Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"> Approve Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Create" asp-route-id="@item.SaleId" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-info-circle"></i> Details
                                        </a>
                                    </td>
                                    <td>
                                        @if (!item.IsApprove)
                                        {
                                            <a asp-action="Approve" asp-route-id="@item.SaleId" class="btn btn-success btn-sm"
                                               onclick="return confirm('Are you sure to approve this sale?');">
                                                <i class="fas fa-check-circle"></i> Approve
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-success fw-semibold"><i class="fas fa-check"></i> Approved</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Invoice" asp-route-id="@item.SaleId" class="btn btn-info btn-sm">
                                            <i class="fas fa-file-invoice"></i> Invoice
                                        </a>
                                    </td>
                                    <td>
                                        <a asp-controller="Payment" asp-action="Create" asp-route-saleid="@item.SaleId" class="btn btn-outline-success btn-sm">
                                            <i class="fas fa-credit-card me-1"></i> Payment
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>



    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchTerm="@ViewBag.SearchTerm">Previous</a>
            </li>
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@ViewBag.SearchTerm">@i</a>
                </li>
            }
            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchTerm="@ViewBag.SearchTerm">Next</a>
            </li>
        </ul>
    </nav>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}
