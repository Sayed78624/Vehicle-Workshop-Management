@model IEnumerable<VehicleWorkShop.ViewModels.VehicleModelVM>




    <div class="row align-items-center mb-4 p-3 rounded bg-light shadow-sm">
        <div class="col-lg-4 col-md-12 mb-2 mb-lg-0">
            <h4 class="mb-0 text-success fw-bold">
                <i class="mb-0 fw-bold me-1"></i> Vehicle Model List
            </h4>
        </div>
        <div class="col-lg-5 col-md-8">
            <form method="get" role="search" class="d-flex">
                <input type="text" name="searchTerm" class="form-control me-2 shadow-sm"
                       placeholder="Search by Name" value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-outline-success shadow-sm">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
        <div class="col-lg-3 col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary shadow-sm w-100">
                <i class="bi bi-person-plus-fill me-1"></i> New Model
            </a>
        </div>
    </div>


    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-primary text-center">
                    <tr>
                        <th style="width: 20%;">@Html.DisplayNameFor(model => model.First().ModelId)</th>
                        <th>@Html.DisplayNameFor(model => model.First().ModelName)</th>
                        <th style="width: 25%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.ModelId</td>
                            <td class="text-center">@item.ModelName</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.ModelId" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.ModelId" class="btn btn-sm btn-outline-info me-1" title="Details">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ModelId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

        @* Pagination  *@
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage - 1 })" tabindex="-1">Previous</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = i })">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage + 1 })">Next</a>
            </li>
        </ul>
    </nav>

</div>
