<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VehicleWorkShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VehicleWorkShop.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />


    <style>
        body {
            display: flex;
            min-height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        .sidebar {
            width: 250px;
            background-color: #212529;
            color: white;
            padding: 20px 15px;
            flex-shrink: 0;
            height: 100vh;
            overflow-y: auto;
        }

            .sidebar h5 {
                text-align: center;
                margin-bottom: 30px;
                color: #ffffff;
            }

            .sidebar a {
                display: block;
                color: white;
                padding: 10px 15px;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background-color: #343a40;
                }

        .accordion-button {
            background-color: transparent;
            color: white;
        }

            .accordion-button:not(.collapsed) {
                background-color: #343a40;
                color: white;
            }

        .accordion-body a {
            padding: 5px 0;
            display: block;
            color: white;
            text-decoration: none;
        }

            .accordion-body a:hover {
                background-color: #495057;
            }

        .content {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100vh;
            background-color: #f8f9fa;
            overflow: hidden;
        }

        .topbar {
            height: 50px;
            background-color: #0d6efd;
            color: white;
            padding: 10px 20px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            flex-shrink: 0;
        }

            .topbar span {
                margin-left: 20px;
                font-weight: 500;
                color: white;
            }

        main.main {
            flex-grow: 1;
            padding: 5px;
            overflow-y: auto;
        }

        /* .footer { */
        /*     height: 20px; */
        /*     background-color: #e9ecef; */
        /*     text-align: center; */
        /*     flex-shrink: 0; */
        /*     font-size: 14px; */
        /*     color: #333; */
        /* } */
    </style>
</head>
<body>

    <div class="sidebar">
        <h5>🚗 VehicleWorkShop</h5>

        <a asp-controller="Dashboard" asp-action="Dashboard">🏠 Dashboard</a>
        <a asp-controller="Home" asp-action="AllStoreReport">📋 AllStoreReport</a>
        <a asp-controller="Product" asp-action="Index">📦 Product</a>

        <div class="accordion" id="accordionInventory">
            <div class="accordion-item bg-transparent border-0">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed px-2 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInventory">
                        📁 Inventory
                    </button>
                </h2>
                <div id="collapseInventory" class="accordion-collapse collapse" data-bs-parent="#accordionInventory">
                    <div class="accordion-body ps-3">
                        <a asp-controller="Category" asp-action="Index"><i class="bi bi-tags me-2"></i> Category</a>
                        <a asp-controller="StockType" asp-action="Index"><i class="bi bi-box-seam me-2"></i> Stock Type</a>
                        <a asp-controller="InventoryType" asp-action="Index"><i class="bi bi-layers me-2"></i> Inventory Type</a>
                        <a asp-controller="WorkShop" asp-action="Index"><i class="bi bi-building-gear me-2"></i> WorkShop</a>
                        <a asp-controller="Store" asp-action="Index"><i class="bi bi-shop me-2"></i> Store</a>
                        <a asp-controller="Model" asp-action="Index"><i class="bi bi-truck-front me-2"></i> Model</a>
                        <a asp-controller="PaymentType" asp-action="Index">💳 Payment</a>
                    </div>
                </div>
            </div>
        </div>

        <a asp-controller="Supplier" asp-action="Index">🚚 Supplier</a>
        <a asp-controller="Customer" asp-action="Index">👥 Customer</a>

        <a asp-controller="Sale" asp-action="Index">🛒 Sale</a>
        <a asp-controller="Transfer" asp-action="Index">🔁 Transfer</a>
        <a asp-controller="Purchase" asp-action="Index">📥 Purchase</a>

        <div class="accordion mt-3" id="accordionUserMgmt">
            <div class="accordion-item bg-transparent border-0">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed px-2 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUserMgmt">
                        🧑‍💼 Users
                    </button>
                </h2>
                <div id="collapseUserMgmt" class="accordion-collapse collapse" data-bs-parent="#accordionUserMgmt">
                    <div class="accordion-body ps-3">
                        <a asp-controller="Role" asp-action="Index">🛡️ Role</a>
                        <a asp-controller="Users" asp-action="Index">👤 Users</a>
                    </div>
                </div>
            </div>
        </div>

        <a class="text-danger mt-4" href="/Account/Logout">🚪 Logout</a>
    </div>

    <div class="content">

        <div class="topbar">
            <span>🔐 Login</span>
            <span>👨‍💼 Admin</span>
        </div>

        <main class="main">
            @RenderBody()
        </main>

        @* <footer class="footer border-top"> *@
        @*     &copy; 2025 - VehicleWorkShop || All Rights Reserved *@
        @* </footer> *@
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

