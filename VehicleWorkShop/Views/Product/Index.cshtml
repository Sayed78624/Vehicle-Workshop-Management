@model IEnumerable<VehicleWorkShop.ViewModels.ProductVM>
@{
    ViewData["Title"] = "Product List";
}

<div class="container mt-0">

    <div class="row align-items-center mb-4 p-3 bg-light rounded shadow-sm">
        <div class="col-lg-4 col-md-12 mb-2 mb-lg-0">
            <h4 class="text-primary fw-bold mb-0">
                <i class="bi bi-building me-2"></i> Product  List
            </h4>
        </div>

        <div class="col-lg-5 col-md-8">
            <form method="get" class="d-flex" role="search">
                <input type="text" name="searchTerm" class="form-control me-2 shadow-sm"
                       placeholder="Search by Prduct Name" value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-outline-primary shadow-sm">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>

        <div class="col-lg-3 col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary w-100 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add  Product
            </a>
        </div>
    </div>


   
    <div class="table-responsive mt-0">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th>SL</th>
                    <th>Product Name</th>
                    <th>Part No</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Image</th>
                    <th>Category</th>
                    <th>Model</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@i</td>
                            <td>@item.ProductName</td>
                            <td>@item.PartNo</td>
                            <td>@item.Description</td>
                            <td><span class="badge bg-primary">৳@item.Price.ToString("N2")</span></td>
                            <td>
                                <img src="@Url.Content("~/Images/" + item.ImageName)" alt="Product Image" class="img-thumbnail" style="width: 50px; height: 50px;" />
                            </td>
                            <td>@item.CategoryName</td>
                            <td>@item.ModelName</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning me-1" title="Edit Product">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger" title="Delete Product" onclick="return confirm('Are you sure you want to delete this product?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted">No products found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage - 1 })" tabindex="-1">Previous</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")" aria-current="@(i == ViewBag.CurrentPage ? "page" : null)">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = i })">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage + 1 })">Next</a>
            </li>
        </ul>
    </nav>

</div>
