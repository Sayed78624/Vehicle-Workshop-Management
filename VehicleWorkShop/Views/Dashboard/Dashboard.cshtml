@{
    ViewData["Title"] = "Dashboard";
}

         @* Chart.js CDN  *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container mt-0">
    <div class="row">

             @* Purchase Overview  *@
        <div class="col-md-3 mb-4">
            <div class="card text-center p-2 shadow-sm" style="height:130px; width:180px; background: linear-gradient(145deg, #e0f7fa, #ffffff); border-left: 5px solid #198754;">
                <h6 class="mt-1 text-dark">Purchase Overview</h6>
                <div style="width:70px; height:70px; margin:0 auto;">
                    <canvas id="purchasechart"></canvas>
                </div>
                <small class="text-muted">@ViewBag.ApprovedPurchase / @ViewBag.TotalPurchase</small>
            </div>
        </div>

             @* Sales Overview  *@
        <div class="col-md-3 mb-0">
            <div class="card text-center p-2 shadow-sm" style="height:130px; width:180px; background: linear-gradient(145deg, #f8f9fa, #ffffff); border-left: 5px solid #0d6efd;">
                <h6 class="mt-1 text-dark">Sales Overview</h6>
                <div style="width:70px; height:70px; margin:0 auto;">
                    <canvas id="salesChart"></canvas>
                </div>
                <small class="text-muted">@ViewBag.ApprovedSales / @ViewBag.TotalSales</small>
            </div>
        </div>


        @* Transfer Overview  *@
        <div class="col-md-3 mb-4">
            <div class="card text-center p-2 shadow-sm" style="height:130px; width:180px; background: linear-gradient(145deg, #fff3cd, #ffffff); border-left: 5px solid #ffc107;">
                <h6 class="mt-0 text-dark">Transfers Overview</h6>
                <div style="width:70px; height:70px; margin:0 auto;">
                    <canvas id="transferChart"></canvas>
                </div>
                <small class="text-muted">@ViewBag.ApprovedTransfers / @ViewBag.TotalTransfers</small>
            </div>
        </div>

    </div>
</div>

