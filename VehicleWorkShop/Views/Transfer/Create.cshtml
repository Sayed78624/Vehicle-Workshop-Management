@model VehicleWorkShop.ViewModels.TransferVM

@{
    ViewData["Title"] = "Create Transfer";
}

<div class="container mt-0">
    <div class="row justify-content-center">
        <div class="col-lg-12">
         
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fas fa-exchange-alt me-2"></i> Transfer Entry</h4>
                        <a asp-action="Index" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>

                <div class="card-body">
              

                    <form asp-action="Create" class="needs-validation" novalidate>
                        <input asp-for="Tran_Id" type="hidden" />

                        
                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input asp-for="Description" class="form-control" id="descriptionInput" placeholder=" " />
                                    <label for="descriptionInput" class="fw-semibold">
                                        <i class="fas fa-file-alt me-1"></i> Transfer Description
                                    </label>
                                </div>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                     
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-success text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><i class="fas fa-boxes me-2"></i> Transfer Product</h5>
                                    <button type="submit" formaction="/Transfer/AddMore" class="btn btn-light btn-sm">
                                        <i class="fas fa-plus me-1"></i> Add Item
                                    </button>
                                </div>
                            </div>

                            <div class="card-body">
                                <!-- Transfer Items Table -->
                                <div class="table-responsive">
                                    <table class="table table-hover table-sm align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th><i class="fas fa-box me-1"></i> Product</th>
                                                <th class="text-center"><i class="fas fa-hashtag me-1"></i> Quantity</th>
                                                <th><i class="fas fa-store me-1"></i> Source Store</th>
                                                <th><i class="fas fa-store me-1"></i> Destination Store</th>
                                                <th class="text-end">Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="detailstable">
                                            @for (int i = 0; i < Model.Details.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        @Html.DropDownList($"Details[{i}].ProductId", Model.Products, "Select Product",
                                                                 new { @class = "form-select form-select-sm", required = "required" })
                                                    </td>
                                                    <td>
                                                        <input asp-for="Details[i].Quantity" class="form-control form-control-sm" min="1" required />
                                                    </td>
                                                    <td>
                                                        @Html.DropDownList($"Details[{i}].SourceStoreId", Model.SourceStores, "Select Source",
                                                                 new { @class = "form-select form-select-sm", required = "required" })
                                                    </td>
                                                    <td>
                                                        @Html.DropDownList($"Details[{i}].DestinationStoreId", Model.DestinationStores, "Select Destination",
                                                                 new { @class = "form-select form-select-sm", required = "required" })
                                                    </td>
                                                    <td class="text-end">
                                                        <button type="button" onclick="RemoveRow(this)" class="btn btn-sm btn-outline-danger">
                                                            <i class="fas fa-trash-alt me-1"></i> Remove
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @if (Model.Details.Count == 0)
                                {
                                    <div class="text-center py-5 bg-light rounded">
                                        <i class="fas fa-exchange-alt fa-3x text-muted mb-3"></i>
                                        <h5 class="text-muted">No transfer items added yet</h5>
                                        <p class="small text-muted">Add items to your transfer using the button above</p>
                                    </div>
                                }
                            </div>
                        </div>

                       
                        <div class="d-flex justify-content-end gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-undo me-1"></i> Back
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-check-circle me-1"></i> Complete Transfer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-header {
        border-radius: 0.35rem 0.35rem 0 0 !important;
    }

    .form-floating label {
        font-weight: 500;
    }

    .table th {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background-color: #f8f9fa !important;
    }

    .table td {
        vertical-align: middle;
        padding: 0.75rem;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }

    .form-control-sm, .form-select-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
</style>

<script>
    function RemoveRow(button) {
        const tableBody = document.getElementById("detailstable");
        if (tableBody.rows.length > 1) {
            button.closest('tr').remove();
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'Cannot Remove',
                text: 'There must be at least one transfer item.',
                confirmButtonColor: '#3085d6',
            });
        }
    }


    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
    })()
</script>