@model IEnumerable<VehicleWorkShop.ViewModels.VehicleModelVM>


<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <i class="bi bi-shield-lock-fill me-2 text-primary" style="font-size: 2rem;"></i>
            <h2 class="mb-0 fw-bold">Vehicle Model List</h2>
        </div>
        <a asp-action="Create" class="btn btn-outline-primary rounded-pill">
            <i class="bi bi-plus-circle me-1"></i> Create Model
        </a>
    </div>

    @* Search box  *@
    <form method="get" class="mb-3 d-flex" role="search">
        <input type="text" name="searchTerm" class="form-control me-2" placeholder="Search by Supplier or Description"
               value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-success">Search</button>
    </form>

    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-primary text-center">
                    <tr>
                        <th style="width: 20%;">@Html.DisplayNameFor(model => model.First().ModelId)</th>
                        <th>@Html.DisplayNameFor(model => model.First().ModelName)</th>
                        <th style="width: 25%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.ModelId</td>
                            <td>@item.ModelName</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.ModelId" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.ModelId" class="btn btn-sm btn-outline-info me-1" title="Details">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ModelId" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

        @* Pagination  *@
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage - 1 })" tabindex="-1">Previous</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = i })">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage + 1 })">Next</a>
            </li>
        </ul>
    </nav>

</div>
