@model VehicleWorkShop.ViewModels.TransferVM

@{
    ViewData["Title"] = "Create Transfer";
}

<div class="container-fluid py-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fas fa-exchange-alt me-2"></i>Create Transfer</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" class="needs-validation" novalidate>

                <div class="row mb-4">
                    <div class="col-md-8 mx-auto">
                       
                        <label asp-for="Description" class="form-label fw-bold mb-2">
                            <i class="fas fa-file-alt me-2"></i>Transfer Description
                        </label>
                        <div class="input-group has-validation">
                            <span class="input-group-text bg-light">
                                <i class="fas fa-pen text-primary"></i>
                            </span>
                            <input asp-for="Description" class="form-control py-2"
                                   placeholder="Enter Description"
                                   style="border-left: none;" />
                            <div class="invalid-feedback">
                                Please provide a transfer description
                            </div>
                        </div>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

               
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="fas fa-list-ul me-2"></i>Transfer Details</h5>
                        <button type="submit" formaction="/Transfer/AddMore" class="btn btn-sm btn-success">
                            <i class="fas fa-plus me-1"></i> Add Row
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-bordered" id="detailsTable">
                            <thead class="table-light">
                                <tr>
                                    <th width="25%">Product</th>
                                    <th width="15%">Quantity</th>
                                    <th width="20%">Source Store</th>
                                    <th width="20%">Destination Store</th>
                                    <th width="20%">Action</th>
                                </tr>
                            </thead>
                            <tbody id="detailstable">
                                @for (int i = 0; i < Model.Details.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Html.DropDownList($"Details[{i}].ProductId", Model.Products, "Select Product",
                                                     new { @class = "form-select form-select-sm", required = "required" })
                                        </td>
                                        <td>
                                            <input asp-for="Details[@i].Quantity" class="form-control form-control-sm" min="1" required />
                                        </td>
                                        <td>
                                            @Html.DropDownList($"Details[{i}].SourceStoreId", Model.SourceStores, "Select Source",
                                                     new { @class = "form-select form-select-sm", required = "required" })
                                        </td>
                                        <td>
                                            @Html.DropDownList($"Details[{i}].DestinationStoreId", Model.DestinationStores, "Select Destination",
                                                     new { @class = "form-select form-select-sm", required = "required" })
                                        </td>
                                        <td class="text-center">
                                            <button type="button" onclick="RemoveRow(this)" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash-alt"></i> Remove
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i> Save Transfer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 0.5rem;
    }

    .card-header {
        border-radius: 0.5rem 0.5rem 0 0 !important;
        padding: 1.25rem 1.5rem;
        text-align:center
    }

    .table th {
        font-size: 0.85rem;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .table td {
        vertical-align: middle;
    }

    .form-select-sm, .form-control-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
</style>

<script>
    function RemoveRow(button) {
        const tableBody = document.getElementById("detailstable");
        if (tableBody.rows.length > 1) {
            button.closest('tr').remove();
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'Cannot Remove',
                text: 'There must be at least one transfer detail.',
                confirmButtonColor: '#3085d6',
            });
        }
    }

     // Form validation
    (function () {
        'use strict'
        var forms = document.querySelectorAll('.needs-validation')
        Array.prototype.slice.call(forms)
            .forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
    })()
</script>