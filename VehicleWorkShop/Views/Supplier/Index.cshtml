@model IEnumerable<VehicleWorkShop.ViewModels.SupplierVM>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="container mt-0">

    <div class="row align-items-center mb-4 p-3 bg-light rounded shadow-sm">
        <div class="col-lg-4 col-md-12 mb-2 mb-lg-0">
            <h4 class="text-primary fw-bold mb-0">
                <i class="bi bi-building me-2"></i> Supplier List
            </h4>
        </div>

        <div class="col-lg-5 col-md-8">
            <form method="get" class="d-flex" role="search">
                <input type="text" name="searchTerm" class="form-control me-2 shadow-sm"
                       placeholder="Search by Supplier Name" value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-outline-primary shadow-sm">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>

        <div class="col-lg-3 col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary w-100 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add New Supplier
            </a>
        </div>
    </div>



  
    <div class="card shadow-sm border-0 rounded-4">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle text-center mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 50px;">SL</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Address</th>
                        <th>Manager</th>
                        <th style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-muted py-4">No suppliers found.</td>
                        </tr>
                    }
                    else
                    {
                        int sl = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@sl</td>
                                <td class="text-start">@item.SupplierName</td>
                                <td>@item.Mobile</td>
                                <td class="text-start">@item.Address</td>
                                <td>@item.Manager</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-sm btn-warning me-1" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.SupplierId" class="btn btn-sm btn-info me-1" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.SupplierId" class="btn btn-sm btn-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                            sl++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    
    <nav class="mt-4" aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage - 1 })">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = i })">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage + 1 })">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>

</div>
