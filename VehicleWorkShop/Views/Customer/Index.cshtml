@model IEnumerable<VehicleWorkShop.ViewModels.CustomerVM>

<div class="container mt-0">

  
    <div class="row align-items-center mb-4 p-3 rounded bg-light shadow-sm">
        <div class="col-lg-4 col-md-12 mb-2 mb-lg-0">
            <h4 class="mb-0 text-success fw-bold">
                <i class="bi bi-people-fill me-1"></i> Customer List
            </h4>
        </div>
        <div class="col-lg-5 col-md-8">
            <form method="get" role="search" class="d-flex">
                <input type="text" name="searchTerm" class="form-control me-2 shadow-sm"
                       placeholder="Search by Name" value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-outline-success shadow-sm">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
        <div class="col-lg-3 col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary shadow-sm w-100">
                <i class="bi bi-person-plus-fill me-1"></i> New Customer
            </a>
        </div>
    </div>

   
    <div class="card shadow-sm border-0 rounded-4">
        <div class="table-responsive">
            <table class="table table-hover text-center align-middle mb-0">
                <thead class="table-dark text-white">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.First().CustomerId)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Name)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Email)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Mobile)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Address)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.CustomerId</td>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>@item.Mobile</td>
                            <td>@item.Address</td>
                            <td>
                                <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

  
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage - 1 })">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = i })">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage + 1 })">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>

</div>
