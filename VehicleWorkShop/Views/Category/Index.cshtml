@model IEnumerable<VehicleWorkShop.ViewModels.CategoryVM>

<div class="container mt-0">
    <div class="card shadow-sm mb-3 border-0">
        <div class="card-body bg-white rounded d-flex justify-content-between align-items-center py-2 px-3">
           
            <div class="d-flex align-items-center">
                <i class="bi bi-tags-fill me-2 text-primary" style="font-size: 24px;"></i>
                <h5 class="mb-0 fw-semibold">Category List</h5>
            </div>

           
            <a asp-action="Create" class="btn btn-outline-success rounded-pill btn-sm px-3">
                <i class="bi bi-plus-circle me-1"></i> Create Category
            </a>
        </div>
    </div>

    <table class="table table-hover table-bordered table-striped">
        <thead class="table-success">
            <tr>
                <th>@Html.DisplayNameFor(model => model.First().CategoryId)</th>
                <th>@Html.DisplayNameFor(model => model.First().Name)</th>
                <th>@Html.DisplayNameFor(model => model.First().IsActive)</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CategoryId</td>
                    <td>@item.Name</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="text-success">Active</span>
                        }
                        else
                        {
                            <span class="text-danger">Inactive</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning me-1" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        
                        <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
