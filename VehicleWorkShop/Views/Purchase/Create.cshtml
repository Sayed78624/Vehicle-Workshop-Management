@model VehicleWorkShop.ViewModels.PurchaseVM
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            @* Main Purchase Card  *@
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fas fa-cart-plus me-2"></i> Purchase Entry</h4>
                        <a asp-action="Index" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4">
                            <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Create" class="needs-validation" novalidate>
                        <input asp-for="PurchaseId" type="hidden" />


                        @* Supplier & Description Section  *@
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    @Html.DropDownListFor(
                                             model => model.SupplierId,
                                             Model.Suppliers,
                                             "Select a Supplier",
                                             new { @class = "form-select", id = "supplierSelect", required = "required" }
                                             )
                                    <label for="supplierSelect" class="fw-semibold">
                                        <i class="fas fa-truck me-1"></i> Supplier <span class="text-danger">*</span>
                                    </label>
                                </div>
                                <span asp-validation-for="SupplierId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Description" class="form-control" id="descriptionInput" placeholder=" " />
                                    <label for="descriptionInput" class="fw-semibold">
                                        <i class="fas fa-file-alt me-1"></i> Description
                                    </label>
                                </div>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        @* Purchase Items Card  *@
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-success text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <i class="fas fa-boxes me-2"></i> Purchase Items
                                    </h5>
                                    <div class="d-flex align-items-center gap-3">

                                        <button type="submit" class="btn btn-light btn-sm text-success shadow-sm">
                                            <i class="fas fa-plus-circle me-1"></i> Add Item
                                        </button>
                                    </div>
                                </div>
                            </div>


                            <div class="card-body">
                                @* Item Entry Form  *@

                                <div class="row g-3 mb-2">
                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small text-muted">
                                            <i class="fas fa-box me-1"></i> Product
                                        </label>
                                        @Html.DropDownListFor(model => model.ProductId, Model.Products, "Select a Product", new { @class = "form-select form-select-sm", id = "productSelect" })
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small text-muted">
                                            <i class="fas fa-cog me-1"></i> Model
                                        </label>
                                        @Html.DropDownListFor(model => model.ModelId, Model.Models, "Select a Model", new { @class = "form-select form-select-sm", id = "modelSelect" })
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small text-muted">
                                            <i class="fas fa-hashtag me-1"></i> Quantity
                                        </label>
                                        <input asp-for="Quantity" class="form-control form-control-sm" type="number" min="1" value="1" onchange="calculateItem()" />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label fw-semibold small text-muted">
                                            <i class="fas fa-tag me-1"></i> Unit Price
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">৳</span>
                                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" value="0" onchange="calculateItem()" />
                                        </div>
                                    </div>
                                </div>


                                <div class="row g-3 mb-4">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small text-muted">
                                            <i class="fas fa-percent me-1"></i> VAT
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <input asp-for="Vat" class="form-control" type="number" min="0" max="100" value="0" onchange="calculateItem()" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small text-muted">
                                            <i class="fas fa-calculator me-1"></i> Subtotal
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">৳</span>
                                            <input asp-for="SubTotal" class="form-control fw-bold text-success" readonly />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold small text-muted">
                                            <i class="fas fa-store me-1"></i> Store
                                        </label>
                                        @Html.DropDownListFor(model => model.StoreId, Model.Stores, "Select a Store", new { @class = "form-select form-select-sm" })
                                    </div>
                                </div>


                                @* Added Items Table *@
                                <div class="mt-4">
                                    @if (Model.PurchaseDetails.Any())
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover table-sm align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th><i class="fas fa-box me-1"></i> Product</th>
                                                        <th class="text-center"><i class="fas fa-hashtag me-1"></i> Qty</th>
                                                        <th class="text-end"><i class="fas fa-tag me-1"></i> Unit Price</th>
                                                        <th class="text-center"><i class="fas fa-percent me-1"></i> VAT</th>
                                                        <th class="text-end"><i class="fas fa-file-invoice-dollar me-1"></i> Subtotal</th>
                                                        <th><i class="fas fa-store me-1"></i> Store</th>
                                                        <th class="text-end">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.PurchaseDetails)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="fw-semibold">@item.ProductName</div>
                                                                <small class="text-muted">@item.ModelName</small>
                                                            </td>
                                                            <td class="text-center">
                                                                <span class="badge bg-primary rounded-pill">@item.Quantity</span>
                                                            </td>
                                                            <td class="text-end">
                                                                ৳@item.Price.ToString("N2")
                                                            </td>
                                                            <td class="text-center">
                                                                <span class="badge bg-info bg-opacity-10 text-info">@item.Vat%</span>
                                                            </td>
                                                            <td class="text-end fw-semibold text-success">
                                                                ৳@item.SubTotal.ToString("N2")
                                                            </td>
                                                            <td>
                                                                <span class="badge bg-light text-dark border">
                                                                    <i class="fas fa-store me-1"></i> @item.StoreName
                                                                </span>
                                                            </td>
                                                            <td class="text-end">
                                                                <a asp-action="RemoveDetail" asp-route-id="@item.PurchaseId"
                                                                   class="btn btn-sm btn-outline-danger">
                                                                    <i class="fas fa-trash-alt me-1"></i> Remove
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                                <tfoot class="table-light">
                                                    <tr>
                                                        <td colspan="4" class="text-end fw-bold">Total Items:</td>
                                                        <td class="text-center fw-bold">@Model.PurchaseDetails.Count</td>
                                                        <td class="text-end fw-bold">Grand Total:</td>
                                                        <td class="text-end fw-bold text-success">
                                                            ৳@Model.PurchaseDetails.Sum(x => x.SubTotal).ToString("N2")
                                                        </td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center py-5 bg-light rounded">
                                            <i class="fas fa-shopping-basket fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No items added yet</h5>
                                            <p class="small text-muted">Add items to your purchase using the form above</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-undo me-1"></i> Back
                            </a>
                            @if (Model.PurchaseId > 0)
                            {
                                <button type="submit" class="btn btn-success px-4">
                                    <i class="fas fa-save me-1"></i> Update Purchase
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-success px-4">
                                    <i class="fas fa-check-circle me-1"></i> Complete Purchase
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function calculateItem() {
        const quantity = parseFloat(document.getElementById("Quantity").value) || 0;
        const price = parseFloat(document.getElementById("Price").value) || 0;
        const vat = parseFloat(document.getElementById("Vat").value) || 0;

        const total = quantity * price;
        const vatAmount = total * (vat / 100);
        const subTotal = total + vatAmount;

        document.getElementById("SubTotal").value = subTotal.toFixed(2);
    }

             // Update grand total display when items change
    function updateGrandTotal() {
        const grandTotal = @Model.PurchaseDetails.Sum(x => x.SubTotal);
        document.getElementById("grandTotalDisplay").textContent = grandTotal.toFixed(2);
    }
</script>


<style>
    .card-header {
        border-radius: 0.35rem 0.35rem 0 0 !important;
    }

    .form-floating label {
        font-weight: 500;
    }

    .table th {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background-color: #f8f9fa !important;
    }

    .table td {
        vertical-align: middle;
        padding: 0.75rem;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(25, 135, 84, 0.05) !important;
    }

    .badge {
        font-weight: 500;
        padding: 0.35em 0.65em;
    }

    .input-group-text {
        background-color: #f8f9fa;
    }

    .form-control-sm, .form-select-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    .text-muted {
        opacity: 0.8;
    }
</style>