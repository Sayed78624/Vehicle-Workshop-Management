@model VehicleWorkShop.ViewModels.TransferInvoiceVM

@{
    Layout = ViewData["From"]?.ToString() == "pdf" ? null : "_Layout";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 20px;
            color: #333;
            line-height: 1.5;
        }

        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 30px;
            border: 1px solid #e0e0e0;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
            background-color: white;
        }

        .company-name {
            color: #2c3e50;
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .invoice-title {
            color: #3498db;
            font-size: 28px;
            margin-bottom: 15px;
            padding-bottom: 10px;
          
        }

        .info-label {
            font-weight: bold;
            color: #555;
            display: inline-block;
            width: 120px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 25px 0;
        }

        th {
            background-color: #3498db;
            color: white;
            padding: 10px;
            text-align: left;
        }

        td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .signature-line {
            border-top: 1px solid #333;
            width: 250px;
            margin: 60px auto 5px;
        }

        .no-print {
            text-align: center;
            margin-top: 30px;
            margin-bottom: 30px;
        }

        .btn {
            padding: 10px 20px;
            margin: 0 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            text-decoration: none;
            display: inline-block;
        }

        .btn-print {
            background-color: #2c3e50;
            color: white;
        }

        .btn-pdf {
            background-color: #e74c3c;
            color: white;
        }

        .btn-back {
            background-color: #95a5a6;
            color: white;
        }

        @@media print {
            .no-print {
                display: none;
            }

            body {
                padding: 0;
                background: none;
            }

            .invoice-container {
                border: none;
                box-shadow: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Header Section -->
        <table style="width: 100%; margin-bottom: 20px;">
            <tr>
                <td style="width: 60%; vertical-align: top;">
                    <div class="invoice-title">TRANSFER INVOICE</div>
                    <p><span class="info-label">Invoice No:</span> TR-@Model.InvoiceId.ToString("D5")</p>
                    <p><span class="info-label">Date:</span> @DateTime.Now.ToString("dd MMMM, yyyy")</p>
                </td>
                <td style="width: 40%; text-align: right; vertical-align: top;">
                    <div class="company-name">Vehicle Workshop</div>
                    <p>123 Workshop Street, Dhaka</p>
                    <p>Phone: +880 1762 843633</p>
                    <p>Email: info@vehicleworkshop.com</p>
                </td>
            </tr>
        </table>

        <!-- Description -->
        <div style="margin: 20px 0;">
            <p><span class="info-label">Transfer Description:</span> @Model.Description</p>
        </div>

        <!-- Items Table -->
        <table>
            <thead>
                <tr>
                    <th style="width: 5%;">SL</th>
                    <th style="width: 45%;">Product Name</th>
                    <th style="width: 15%;">Quantity</th>
                    <th style="width: 15%;">Source Store</th>
                    <th style="width: 20%;">Destination Store</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int sl = 1;
                }
                @foreach (var item in Model.Details)
                {
                    <tr>
                        <td>@(sl++)</td>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.SourceStoreName</td>
                        <td>@item.DestinationStoreName</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Signature Section -->
        <table style="width: 100%; margin-top: 60px;">
            <tr>
                <td style="width: 50%; text-align: center;">
                    <strong>Prepared By</strong>
                    <div class="signature-line"></div>
                    <p>Name & Signature</p>
                </td>
                <td style="width: 50%; text-align: center;">
                    <strong>Received By</strong>
                    <div class="signature-line"></div>
                    <p>Name & Signature</p>
                </td>
            </tr>
        </table>
    </div>

    @if (ViewData["From"]?.ToString() != "pdf")
    {
        <div class="no-print">
            <button onclick="window.print()" class="btn btn-print">
                Print Invoice
            </button>
            <a asp-action="DownloadInvoice" asp-route-id="@Model.InvoiceId" class="btn btn-pdf">
                Download PDF
            </a>
            <a asp-action="Index" class="btn btn-back">
                Back To List
            </a>
        </div>
    }
</body>
</html>