@model IEnumerable<VehicleWorkShop.ViewModels.PurchaseVM>

<div class="container mt-0">




    <div class="card shadow-sm border-0">

        <div class="card-header bg-success text-white py-2">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                <h6 class="mb-0 fw-semibold">
                    <i class="fas fa-table me-2"></i> All Purchase Records
                </h6>


                <form method="get" class="d-flex align-items-center" role="search">
                    <input type="text" name="searchTerm" class="form-control form-control-sm me-2"
                           placeholder="Search by Supplier" value="@ViewBag.SearchTerm" />
                    <button type="submit" class="btn btn-light btn-sm text-success">
                        <i class="fas fa-search me-1"></i> Search
                    </button>
                </form>


                <a asp-action="Create" class="btn btn-light btn-sm">
                    <i class="fas fa-plus-circle me-1"></i> New Purchase
                </a>
            </div>
        </div>


        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-success text-center">
                        <tr>
                            <th>SL</th>
                            <th>Supplier</th>
                            <th>Description</th>
                            <th>Grand Total</th>
                            <th>Approved</th>
                            <th>Details</th>
                            <th>Approve</th>
                            <th>Invoice</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle me-2"></i>No purchase records found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr class="text-center">
                                    <td><span class="badge bg-light text-dark">@item.PurchaseId</span></td>
                                    <td>@item.SupplierName</td>
                                    <td>@item.Description</td>
                                    <td>@item.GrandTotal</td>

                                    <td>
                                        @if (item.IsApprove)
                                        {
                                            <span class="badge bg-success">Already Approved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Approve</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Create" asp-route-id="@item.PurchaseId" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-eye me-1"></i>Details
                                        </a>
                                    </td>
                                    <td>
                                        <a asp-action="Approve" asp-route-id="@item.PurchaseId"
                                           class="btn btn-outline-success btn-sm"
                                           onclick="return confirm('Are you sure to approve this purchase?');">
                                            <i class="fas fa-check-circle me-1"></i>Approve
                                        </a>
                                    </td>
                                    <td>
                                        <a asp-action="Invoice" asp-route-id="@item.PurchaseId" class="btn btn-outline-secondary btn-sm">
                                            <i class="fas fa-file-invoice me-1"></i>Invoice
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Pagination  *@
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage - 1 })" tabindex="-1">Previous</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = i })">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new { searchTerm = ViewBag.SearchTerm, page = ViewBag.CurrentPage + 1 })">Next</a>
            </li>
        </ul>
    </nav>
</div>