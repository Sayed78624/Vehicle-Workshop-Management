<div class="card mt-1">
    <div class="card-header bg-info text-dark text-center">
         Low Stock Chart
    </div>
    <div class="card-body">
        <canvas id="lowStockChart" width="400" height="200"></canvas>
    </div>
</div>


<script>
    // Purchase Chart
    const ctx = document.getElementById('purchasechart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Approved', 'Pending'],
            datasets: [{
                data: [@ViewBag.ApprovedPurchase, @ViewBag.TotalPurchase - @ViewBag.ApprovedPurchase],
                backgroundColor: ['#198754', '#ffc107']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: { display: false },
                tooltip: { enabled: true }
            }
        }
    });

    // Sales Chart

    const ctx1 = document.getElementById('salesChart').getContext('2d');
    new Chart(ctx1, {
        type: 'doughnut',
        data: {
            labels: ['Approved', 'Pending'],
            datasets: [{
                data:  [@ViewBag.ApprovedSales, @ViewBag.TotalSales - @ViewBag.ApprovedSales],
                backgroundColor: ['#198754', '#f8d7da']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: {display: false},
                tooltip: {enabled: true}
            }
        }
    });
    // Transfer Chart
    const ctx2 = document.getElementById('transferChart').getContext('2d');
    new Chart(ctx2, {
        type: 'doughnut',
        data: {
            labels: ['Approved', 'Pending'],
            datasets: [{
                data: [@ViewBag.ApprovedTransfers, @ViewBag.TotalTransfers - @ViewBag.ApprovedTransfers],
                backgroundColor: ['#198754', '#ffc107']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: { display: false },
                tooltip: { enabled: true }
            }
        }
    });

    // Product chart
    //  const modelNames = @Html.Raw(Json.Serialize(ViewBag.ModelNames));
    // const productCounts = @Html.Raw(Json.Serialize(ViewBag.ProductCounts));

    //     const ctxBar = document.getElementById('modelProductChart').getContext('2d');
    // new Chart(ctxBar, {
    //     type: 'bar',
    //     data: {
    //         labels: modelNames,
    //         datasets: [{
    //             label: 'Product Count',
    //             data: productCounts,
    //             backgroundColor: '#0d6efd',
    //             borderRadius: 5
    //         }]
    //     },
    //     options: {
    //         responsive: true,
    //         plugins: {
    //             legend: { display: false },
    //             tooltip: { enabled: true }
    //         },
    //         scales: {
    //             y: {
    //                 beginAtZero: true,
    //                 ticks: { stepSize: 1 }
    //             }
    //         }
    //     }
    // });
    const rawData = @Html.Raw(ViewBag.LowStockChart);
    const labels = rawData.map(item => item.ProductName);
    const data = rawData.map(item => item.Quantity);

    const ctx3 = document.getElementById('lowStockChart').getContext('2d');
    const lowStockChart = new Chart(ctx3, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Available Quantity',
                data: data,
                backgroundColor: data.map(qty => qty == 0 ? 'red' : qty <= 2 ? 'orange' : 'blue'),
                borderColor: 'black',
                borderWidth: 1
            }]
        },
        options: {
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1 
                    },
                    title: {
                        display: true,
                        text: 'Quantity'
                    }
                },
                x: {
                    title: {
                        display: true,
                        text: 'Product Name'
                    }
                }
            },
            plugins: {
                title: {
                    display: true,
                    text: 'Low Stock Items'
                },
                legend: {
                    display: false
                }
            }
        }
    });

</script>

